{
  "name": "todostickers",
  "productName": "TodoStickers",
  "version": "1.0.1",
  "description": "Sticky notes for your Windows desktop",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.todostickers.app",
    "productName": "TodoStickers",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "icon.ico",
      "icon.png"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TodoStickers",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "TodoStickers-Setup-${version}.${ext}"
    }
  }
}
